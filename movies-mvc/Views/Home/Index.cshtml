@model List<Pelicula>
@{
    ViewData["Title"] = "Catálogo";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    var busqueda = ViewBag.Busqueda ?? "";
    //Para obtener el valor actual seleccionado y mantener el filtro
    var generoIdActual = ((SelectList)ViewBag.GeneroId).SelectedValue ?? 0;
    var plataformaIdActual = ((SelectList)ViewBag.PlataformaId).SelectedValue ?? 0;

    //Para el texto de los dropdowns, busco el texto del item seleccionado comparando con el valor actual
    var generoTexto = "";
    var plataformaTexto = "";
    foreach (var item in ViewBag.GeneroId)
    {
        if (item.Value.ToString() == generoIdActual.ToString())
        {
            generoTexto = item.Text;
            break;
        }
    }

    foreach (var item in ViewBag.PlataformaId)
    {
        if (item.Value.ToString() == plataformaIdActual.ToString())
        {
            plataformaTexto = item.Text;
            break;
        }
    }
}

<main class="container py-5">
    <section class="hero-section text-center mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-4">Descubre tu nueva obsesión</h1>
                <form method="get">
                    <div class="input-group input-group-lg shadow-sm mb-4">
                        <span class="input-group-text border-end-0">
                            <span class="material-symbols-outlined text-muted">search</span>
                        </span>
                        <input name="txtBusqueda" class="form-control border-start-0" placeholder="Buscá por película, género, plataforma..." type="text" value="@busqueda" />
                        <button class="btn btn-danger px-4" type="submit">Buscar</button>
                    </div>
                    <div class="d-flex justify-content-center gap-3 mb-4">
                        <div class="dropdown">
                            @* Los dropdowns están como buttons para mantener el estilo de boostrap. *@
                            @* Si uso select de asp es más limpio pero pierdo el estilo. *@
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @generoTexto
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var item in ViewBag.GeneroId)
                                {
                                    <li><a class="dropdown-item" href="@($"?generoId={item.Value}&plataformaId={plataformaIdActual}&txtBusqueda={busqueda}")">@item.Text</a></li>
                                }
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @plataformaTexto
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var item in ViewBag.PlataformaId)
                                {
                                    <li><a class="dropdown-item" href="@($"?generoId={generoIdActual}&plataformaId={item.Value}&txtBusqueda={busqueda}")">@item.Text</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="h3 fw-bold mb-0">Catálogo</h2>
                <div class="bg-danger" style="height: 4px; width: 40px; border-radius: 2px;"></div>
            </div>
            <a class="btn btn-link text-danger text-decoration-none fw-bold p-0" href="@($"?generoId=0&plataformaId=0&txtBusqueda=")">Ver todas</a>
        </div>
        <nav class="mt-5" aria-label="Paginación">
            <ul class="pagination justify-content-center">


                <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="1" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">«</a>
                </li>
                <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">‹</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    @if (i == currentPage)
                    {
                        <li class="page-item active">
                            <span class="page-link">@i</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a asp-action="Index" asp asp-route-page="@i" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">@i</a>
                        </li>
                    }
                }

                <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">›</a>
                </li>
                <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="@totalPages" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">»</a>
                </li>
            </ul>
        </nav>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var pelicula in Model)
            {
                <div class="col">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@pelicula.Id" class="text-decoration-none">
                        <div class="card movie-card  h-100">
                            <div class="card-img-container">
                                <img alt="@pelicula.Titulo" class="card-img-top " src="@pelicula.PosterUrlPortada" style="aspect-ratio: 2/3; object-fit: cover;" />
                                <div class="rating-badge">
                                    <span class="material-symbols-outlined" style="font-size: 14px; font-variation-settings: 'FILL' 1">star</span> @pelicula.PromedioRating
                                </div>
                            </div>
                            <div class="card-body p-2">
                                <h6 class="card-title text-truncate mb-0 fw-bold">@pelicula.Titulo</h6>
                                <p class="card-text small text-body-secondary">@pelicula.Genero.Descripcion • @pelicula.FechaLanzamiento.Year</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
        <nav class="mt-5" aria-label="Paginación">
            <ul class="pagination justify-content-center">


                <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="1" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">«</a>
                </li>
                <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">‹</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    @if (i == currentPage)
                    {
                        <li class="page-item active">
                            <span class="page-link">@i</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a asp-action="Index" asp asp-route-page="@i" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">@i</a>
                        </li>
                    }
                }

                <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">›</a>
                </li>
                <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                    <a asp-action="Index" asp-route-page="@totalPages" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoIdActual" asp-route-plataformaId="@plataformaIdActual" class="page-link">»</a>
                </li>
            </ul>
        </nav>
    </section>

</main>

