@using Microsoft.AspNetCore.Identity
@using System.Globalization
@model Pelicula;
@inject SignInManager<Usuario> SignInManager

@{
    // Cálculo de estadísticas de reseñas
    var totalReviews = Model.ListaReviews?.Count ?? 0;
    var ratings = Model.ListaReviews?
        .GroupBy(r => r.Rating)
        .ToDictionary(g => g.Key, g => g.Count())
        ?? new Dictionary<int, int>();

    var userLogged = SignInManager.IsSignedIn(User);
    var esAdmin = User.IsInRole("Admin");

    ViewData["Title"] = "Detalles";
}

<!-- Main Content -->
<main class="container py-4">
    <div class="row g-5">
        <!-- Left Column: Poster -->
        <div class="col-lg-4">
            <div class="position-static" style="top: 100px;">
                <img alt="@Model.Titulo" class="img-fluid movie-poster mb-4 w-100" src="@Model.PosterUrlPortada" />
                <div class="d-grid gap-2">
                    <button @(ViewBag.UserReview || !userLogged ? "disabled" : "") class="btn btn-danger btn-lg d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#createReviewModal" type="button">
                        <span class="material-symbols-outlined">add_notes</span> Agregar reseña
                    </button>
                    @*                     <button class="btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center gap-2">
                        <span class="material-symbols-outlined">add</span> Agregar a mi lista
                    </button> *@
                </div>
            </div>
        </div>
        <!-- Right Column: Details -->
        <div class="col-lg-8">
            <div class="mb-4">
                <h1 class="display-3 fw-black mb-2">@Model.Titulo</h1>
                <div class="d-flex align-items-center gap-3 text-body-secondary mb-4">
                    <span class="badge rounded-pill badge-genre">@Model.Genero.Descripcion</span>
                    <span>•</span>
                    <span class="fw-bold">@Model.FechaLanzamiento.Year</span>
                    <span>•</span>
                    <span>@(Model.MinutosDuracion / 60)h @(Model.MinutosDuracion % 60)m</span>
                    <span>•</span>
                    <span class="badge rounded-pill badge-genre">@Model.Plataforma.Nombre</span>
                </div>
                <h4 class="fw-bold mb-3">Sinopsis</h4>
                <p class="lead text-body-secondary lh-lg mb-5">
                    @Model.Sinopsis
                </p>
            </div>

            <hr class="border-secondary opacity-25 mb-5" />
            <!-- Review Summary -->
            <div class="row g-4 mb-5">
                <div class="col-md-12">
                    <div class="p-4 bg-custom-card review-box d-md-flex align-items-center gap-5">
                        <div class="text-center mb-4 mb-md-0">
                            <div class="display-2 fw-black text-danger">@Model.PromedioRating.ToString("0.0") </div>
                            <div class="star-rating text-danger mb-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= @Model.PromedioRating)
                                    {
                                        <span class="material-symbols-outlined star-filled">star</span>
                                    }
                                    else if (i > @Model.PromedioRating && i < @Model.PromedioRating + 1)
                                    {
                                        <span class="material-symbols-outlined star-half">star</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined star-empty">grade</span>
                                    }
                                }
                            </div>
                            <div class="small text-body-secondary">Basado en @(Model.ListaReviews != null ? Model.ListaReviews.Count() : 0) reseñas</div>
                        </div>
                        <!-- Distribución de ratings  -->
                        <div class="flex-grow-1">
                            @for (int i = 5; i >= 1; i--)
                            {
                                var count = ratings.ContainsKey(i) ? ratings[i] : 0;
                                var percent = totalReviews > 0 ? (double)count / totalReviews * 100 : 0;

                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span style="width:20px">@i</span>

                                    <div class="progress flex-grow-1 bg-body-secondary" style="height:8px;">
                                        <div class="progress-bar bg-danger"
                                             role="progressbar"
                                             style="width:@percent.ToString("0.0", CultureInfo.InvariantCulture)%"
                                             aria-valuenow="@percent"
                                             aria-valuemin="0"
                                             aria-valuemax="100"></div>
                                    </div>
                                    <span style="width:35px">(@count)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!--Botones IA-->
            <div class="d-grid d-flex justify-content-center gap-3 d-sm-flex my-4">
                <button onclick="cargarLlm('Resumen', '@Model.Titulo')" class="btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center gap-2">
                    <span class="material-symbols-outlined">auto_awesome</span>
                    <span>Resumen IA</span>
                </button>
                <button onclick="cargarLlm('Spoiler', '@Model.Titulo')" class="btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center gap-2">
                    <span class="material-symbols-outlined">movie</span>
                    <span>Tirame un spoiler</span>
                </button>
                <button onclick="cargarLlm('NuevoPoster', '@Model.Titulo')" class="btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center gap-2">
                    <span class="material-symbols-outlined">image</span>
                    <span>Genera nuevo póster</span>
                </button>
            </div>
            <!-- Cartel de review ya existe -->
            @if (TempData["ReviewExiste"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>@TempData["ReviewExiste"]</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <!-- Detailed Reviews -->
            <div class="list-group list-group-flush border-top border-secondary-subtle">
                <!-- Reviews -->
                @foreach (var item in Model.ListaReviews)
                {

                    <div class="list-group-item bg-transparent border-secondary-subtle py-4 px-0">
                        <div class="d-flex gap-3">
                            <img alt="@item.Usuario.Nombre" class="rounded-circle avatar-img"
                                 src="@(string.IsNullOrEmpty(item.Usuario.ImagenUrlPerfil) ? "/images/default-avatar.png" : item.Usuario.ImagenUrlPerfil)"
                                 onerror="this.src='/images/default-avatar.png'" />
                            <div class="w-100">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-0 fw-bold">@string.Concat(item.Usuario.Nombre + " " + item.Usuario.Apellido)</h6>
                                        <div class="star-rating text-danger mt-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= item.Rating)
                                                {
                                                    <span class="material-symbols-outlined star-filled">star</span>
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined star-empty">grade</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <span class="small text-body-secondary">@item.FechaReview.ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="text-body-secondary">@item.Comentario</p>
                                @if (userLogged && esAdmin)
                                {
                                    <a asp-action="Edit" asp-controller="Review" asp-route-id="@item.Id" class="btn btn-outline-warning">Editar</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="d-grid mt-4">
                <button class="btn btn-outline-secondary py-3 fw-bold">Load More Reviews</button>
            </div>
        </div>
    </div>
</main>

@{
    var reviewModel = new ReviewCreateViewModel
    {
        PeliculaId = Model.Id,
        PeliculaTitulo = Model.Titulo
    };
}

<partial name="~/Views/Review/_CreateReview.cshtml" model="reviewModel" />

@* Modal LLM *@
@{
    var llmViewModel = new ModalLlmViewModel
    {
        Tipo = "",
        Pelicula = Model.Titulo,
        SpoilerResumen = ""
    };
}
<partial name="~/Views/Home/_ModalLlm.cshtml" model="llmViewModel" />

@section Scripts {
    <script>
        function cargarLlm(tipo, titulo) {
            // Mostrar el modal
            const modal = new bootstrap.Modal(document.getElementById('llmModal'));

            // Actualizar el título del modal
            document.getElementById('modalTipoTexto').textContent = tipo;
            document.getElementById('modalPeliculaTexto').textContent = titulo;

            // Mostrar spinner y ocultar contenido
            document.getElementById('llmModalLoading').style.display = 'block';
            document.getElementById('llmModalContent').style.display = 'none';

            modal.show();

            // Determinar la URL según el tipo
           let url = '';
            if (tipo === 'Spoiler') {
                url = '@Url.Action("Spoiler", "Home")?titulo=' + encodeURIComponent(titulo);
            } else if (tipo === 'NuevoPoster') {
                url = '@Url.Action("NuevoPoster", "Home")?titulo=' + encodeURIComponent(titulo);
            } else {
                url = '@Url.Action("Resumen", "Home")?titulo=' + encodeURIComponent(titulo);
            }

            // Hacer la llamada AJAX
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // document.getElementById('llmModalContent').innerHTML = '<p>' + data.data + '</p>';

                        // Verificamos si es tipo imagen o texto
                        if (tipo === 'NuevoPoster') {
                            // Insertamos una imagen con clases de Bootstrap para que se vea bien
                            document.getElementById('llmModalContent').innerHTML = '<div class="text-center"><img src="' + data.data + '" class="img-fluid rounded shadow" /></div>';
                        } else {
                            // Es un texto normal (Resumen o Spoiler)
                            document.getElementById('llmModalContent').innerHTML = '<p>' + data.data + '</p>';
                        }
                    } else {
                        document.getElementById('llmModalContent').innerHTML =
                            '<div class="alert alert-danger">Error: ' + data.message + '</div>';
                    }
                })
                .catch(error => {
                    document.getElementById('llmModalContent').innerHTML =
                        '<div class="alert alert-danger">Error al cargar la información: ' + error.message + '</div>';
                })
                .finally(() => {
                    // Ocultar spinner y mostrar contenido
                    document.getElementById('llmModalLoading').style.display = 'none';
                    document.getElementById('llmModalContent').style.display = 'block';
                });
        }
    </script>
}