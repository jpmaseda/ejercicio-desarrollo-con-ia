@model IEnumerable<movies_mvc.Models.Genero>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a class="link-cs" asp-action="Create">Agregar género</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>
                <td>
                    <a class="link-cs" asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a class="link-cs" asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                    <a class="link-cs" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
