@using Microsoft.AspNetCore.Identity
@* @inject UserManager<Usuario> UserManager
 *@
@inject SignInManager<Usuario> SignInManager
@{
    var userLogged = SignInManager.IsSignedIn(User);
    var esAdmin = User.IsInRole("Admin");
    // var esAdmin = UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "Admin").Result;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CINE STREAM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/movies_mvc.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Early theme loading to prevent flashing -->
    <script>
        (function () {
            const THEME_KEY = 'bs-theme';
            const savedTheme = localStorage.getItem(THEME_KEY) || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body border-bottom box-shadow mb-3 sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="material-symbols-outlined text-danger me-2 fs-3">movie</span>
                    <span>CINE<span class="text-danger">STREAM</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (userLogged)
                        {
                            if (esAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Review" asp-action="Index">Reviews</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Plataforma" asp-action="Index">Plataforma</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Genero" asp-action="Index">Género</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Pelicula" asp-action="Index">Películas</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Review" asp-action="Index">Mis Reviews</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="ms-auto">
                        <button class="btn btn-outline-danger" id="themeToggle" type="button" title="Cambiar tema">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>
                    </div>
                </div>
                <ul class="navbar-nav flex-grow">

                    @if (userLogged)
                    {
                        <div class="dropdown ms-2">
                            <a class="d-block link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" href="#">
                                <img alt="mdo" class="rounded-circle border border-danger" data-alt="User avatar close up" height="40" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCC9-STwITTCmmiUzMgG-s_RJICB-hYUx7V3H7mAOpeLkYxPAge_jhEQbe_p-_aHXm811f7mbQjfk8NimMGuxOUzwFSdWGJ4KUgpdyyE6hczgBAe2cNgDxy1c7cs-9yqGc2sp_JbOQrOV0BuvEFLF0vLfY_SBZbXCutJxzAsoydHp6-4YJSTO1raG_m3e7yKLMOoM_MzclCm0TTpnaaiXpepqJLL8n0WvU34pUDc_Il362uzoDmDqPzSoP3BdQkk0_ibNtcwOXKbAzh" width="40" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><a asp-action="Perfil" asp-controller="Usuario" class="dropdown-item">Mi Perfil</a></li>
                                <li><a class="dropdown-item" href="#">Ajustes</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a asp-action="Logout" asp-controller="Usuario" class="dropdown-item text-danger">Cerrar Sesión</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        //botonera para usuario no loggeado
                        <li class="nav-item ms-1">
                            <a class="btn btn-outline-danger " asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
                            <a class="btn btn-outline-danger " asp-controller="Usuario" asp-action="Registro">Registrarse</a>
                        </li>
                    }
                </ul>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CINE STREAM
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Dark Mode Toggle Script -->
    <script>
        (function () {
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const htmlElement = document.documentElement;
            const THEME_KEY = 'bs-theme';

            // Initialize icon based on current theme
            const currentTheme = htmlElement.getAttribute('data-bs-theme') || 'light';
            updateIcon(currentTheme);

            // Toggle theme on button click
            themeToggle.addEventListener('click', function () {
                const currentTheme = htmlElement.getAttribute('data-bs-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                htmlElement.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem(THEME_KEY, newTheme);
                updateIcon(newTheme);
            });

            function updateIcon(theme) {
                if (theme === 'dark') {
                    themeIcon.classList.remove('bi-moon-fill');
                    themeIcon.classList.add('bi-sun-fill');
                } else {
                    themeIcon.classList.remove('bi-sun-fill');
                    themeIcon.classList.add('bi-moon-fill');
                }
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
