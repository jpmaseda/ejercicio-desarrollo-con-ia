@model PerfilViewModel

@{
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">            
            <form method="post" novalidate enctype="multipart/form-data">
                @*enctype sirve para que el formulario cargue distintos tipos de datos*@
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-5">
                        <div class="profile-img-container mb-3">
                            <img id="profileImage" alt="Imagen de perfil" class="profile-img" data-alt="Imagen de perfil" src="@Model.ImagenUrlPerfil" />
                            <label class="img-overlay" asp-for="ImagenPerfil" @* onclick="document.getElementById('ImagenPerfil').click()" *@> @* NO hace falta en onclick porque la label llama al input type=file *@
                                <span class="material-symbols-outlined">photo_camera</span>
                            </label>
                            <input class="d-none" asp-for="ImagenPerfil" type="file" accept="image/png,image/jpeg,image/webp" onchange="previewImage(this)" />
                        </div>
                        <h3 class="fw-bold mb-1">@Model.Nombre @Model.Apellido</h3>
                        <p class="text-secondary small">@Model.Email</p>
                    </div>
                    <div class="row g-4">
                        @if (TempData["Mensaje"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <strong>Éxito!</strong> @TempData["Mensaje"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label fw-medium" asp-for="Nombre"></label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Tu nombre" />
                            <span asp-validation-for="Nombre" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label fw-medium"></label>
                            <input asp-for="Apellido" class="form-control form-control-lg" placeholder="Tu apellido" />
                            <span asp-validation-for="Apellido" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FechaNacimiento" class="form-label fw-medium">Fecha de Nacimiento</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary">
                                    <span class="material-symbols-outlined">calendar_today</span>
                                </span>
                                <input asp-for="FechaNacimiento" class="form-control form-control-lg" />
                                <div asp-validation-summary="ModelOnly" class="text-danger small mt-1"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-medium"></label>
                            <input asp-for="Email" class="form-control form-control-lg" disabled />
                        </div>
                        <div class="col-12 mt-5">
                            <div class="d-flex flex-wrap gap-3 justify-content-start">
                                <button class="btn btn-danger px-4 py-2 fw-bold order-2 order-md-1" type="submit">Guardar Cambios</button>
                                <button class="btn btn-outline-secondary px-4 py-2 fw-medium order-1 order-md-2" asp-action="Index" asp-controller="Home">Cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
     function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('profileImage').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>